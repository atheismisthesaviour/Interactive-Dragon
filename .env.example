# Optional AI review. Without this, deterministic checks still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Use a strong random value for reviewer decisions in production.
REVIEWER_API_KEY=
APP_SECRET_KEY=change-me-before-production

# SQLite is for demo only. Use managed PostgreSQL for production.
DATABASE_URL=sqlite:///./brandguard.db
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
